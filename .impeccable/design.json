      "css": ":host{--azul-900:#12324f;--azul-700:#1f4e79;--azul-600:#2e74b5;--azul-400:#5b9bd5;--azul-200:#b7d3ee;--cielo-100:#dcebf7;--cielo-50:#eef5fb;--amarillo:#f2c230;--verde:#5e9e4b;--verde-100:#e2f0db;--verde-ink:#2c5e1f;--naranja-100:#fbe7d3;--naranja-ink:#8a4a0e;--rojo:#b3403a;--rojo-100:#f6dedc;--rojo-ink:#8e2c27;--tinta:#152536;--tinta-2:#46596c;--linea:#c8d9ea;--fuente-titulo:'Montserrat',Arial,sans-serif;--fuente:Arial,'Helvetica Neue',Helvetica,sans-serif}.ds-campo{display:flex;flex-direction:column;gap:5px;width:220px;font-family:var(--fuente)}.ds-campo span{font:600 12.5px/1.2 var(--fuente-titulo);color:var(--tinta-2)}.ds-campo input{height:38px;padding:0 10px;border:1px solid var(--linea);border-radius:6px;background:#fff;font:14px var(--fuente);color:var(--tinta);transition:border-color .15s ease-out}.ds-campo input:hover{border-color:var(--azul-400)}.ds-campo input:focus-visible{outline:2px solid var(--azul-600);outline-offset:0;border-color:var(--azul-600)}"
