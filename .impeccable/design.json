      "css": ":host{--azul-900:#12324f;--azul-700:#1f4e79;--azul-600:#2e74b5;--azul-400:#5b9bd5;--azul-200:#b7d3ee;--cielo-100:#dcebf7;--cielo-50:#eef5fb;--amarillo:#f2c230;--verde:#5e9e4b;--verde-100:#e2f0db;--verde-ink:#2c5e1f;--naranja-100:#fbe7d3;--naranja-ink:#8a4a0e;--rojo:#b3403a;--rojo-100:#f6dedc;--rojo-ink:#8e2c27;--tinta:#152536;--tinta-2:#46596c;--linea:#c8d9ea;--fuente-titulo:'Montserrat',Arial,sans-serif;--fuente:Arial,'Helvetica Neue',Helvetica,sans-serif}.ds-estado{display:inline-flex;align-items:center;height:22px;padding:0 8px;border-radius:4px;font:600 12px/1 var(--fuente-titulo);white-space:nowrap}.ds-base{background:var(--cielo-100);color:var(--azul-700)}.ds-firme{background:var(--azul-700);color:#fff}.ds-transito{background:var(--amarillo);color:var(--azul-900)}.ds-ok{background:var(--verde-100);color:var(--verde-ink)}.ds-alerta{background:var(--naranja-100);color:var(--naranja-ink)}.ds-baja{background:var(--rojo-100);color:var(--rojo-ink)}"
