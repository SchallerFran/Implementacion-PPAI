      "css": ":host{--azul-900:#12324f;--azul-700:#1f4e79;--azul-600:#2e74b5;--azul-400:#5b9bd5;--azul-200:#b7d3ee;--cielo-100:#dcebf7;--cielo-50:#eef5fb;--amarillo:#f2c230;--verde:#5e9e4b;--verde-100:#e2f0db;--verde-ink:#2c5e1f;--naranja-100:#fbe7d3;--naranja-ink:#8a4a0e;--rojo:#b3403a;--rojo-100:#f6dedc;--rojo-ink:#8e2c27;--tinta:#152536;--tinta-2:#46596c;--linea:#c8d9ea;--fuente-titulo:'Montserrat',Arial,sans-serif;--fuente:Arial,'Helvetica Neue',Helvetica,sans-serif}.ds-barra{display:flex;align-items:stretch;gap:2px;height:60px;padding:0 20px 0 24px;background:var(--azul-700);color:#fff}.ds-barra strong{display:flex;align-items:center;margin-right:26px;font:700 18px var(--fuente-titulo)}.ds-barra a{position:relative;display:flex;align-items:center;padding:0 14px;color:rgb(255 255 255/.8);text-decoration:none;font:600 14px var(--fuente-titulo);transition:color .15s ease-out,background-color .15s ease-out}.ds-barra a:hover{color:#fff;background:rgb(255 255 255/.07)}.ds-barra a.ds-activo{color:#fff}.ds-barra a.ds-activo::after{content:'';position:absolute;left:12px;right:12px;bottom:0;height:3px;border-radius:3px 3px 0 0;background:#fff}.ds-barra a:focus-visible{outline:2px solid var(--amarillo);outline-offset:-4px}"
