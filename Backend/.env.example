# Copiar este archivo como .env (mismo directorio) y completar los valores.
# .env NO se sube al repositorio (está en .gitignore).

# Puerto del backend (8080 lo usa la API mock del GPS Tracker)
SERVER_PORT=8081

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bolsines
DB_USER=postgres
DB_PASSWORD=

# API mock del GPS Tracker (https://github.com/LiberaeMentis/dsi-api-bolsines)
GPS_BASE_URL=http://localhost:8080
# XTR-4500L | NavTrack QX-7A | GeoPulse MTR-900
GPS_DISPOSITIVO_POR_DEFECTO=XTR-4500L
# Keys de la API mock (publicadas en el README del repositorio de la cátedra)
GPS_API_KEY_XTR=sk_xtr_9F3a7C21bE6d4A10f2c8e5b7d913
GPS_API_KEY_NAVTRACK=sk_nav_7b61d9e4c3a2485fae10c77d5b2f
GPS_API_KEY_GEOPULSE=sk_geo_f2d84a1c9e7345b8a6d1c3f0972e

# Orígenes permitidos (CORS) para el frontend, separados por coma
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
